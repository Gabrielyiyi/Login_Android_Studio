<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="24dp"
    tools:context=".DetailActivity">

    <View
        android:id="@+id/glassCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass"
        app:layout_constraintBottom_toTopOf="@+id/btnRegresar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginBottom="32dp"/>

    <ImageView
        android:id="@+id/ivDetailImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_margin="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="@+id/glassCard"
        tools:src="@drawable/img_course_web" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="Título del Curso"
        android:textColor="#333333"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/glassCard"
        app:layout_constraintStart_toStartOf="@+id/glassCard"
        app:layout_constraintTop_toBottomOf="@+id/ivDetailImage" />

    <TextView
        android:id="@+id/tvDetailCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="Categoría"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/glassCard"
        app:layout_constraintTop_toBottomOf="@+id/tvDetailTitle" />

    <TextView
        android:id="@+id/tvDetailInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="Nivel | Duración"
        android:textColor="#555555"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/glassCard"
        app:layout_constraintStart_toStartOf="@+id/glassCard"
        app:layout_constraintTop_toBottomOf="@+id/tvDetailCategory" />

    <TextView
        android:id="@+id/tvDetailDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="Descripción detallada del curso..."
        android:textColor="#444444"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/glassCard"
        app:layout_constraintStart_toStartOf="@+id/glassCard"
        app:layout_constraintTop_toBottomOf="@+id/tvDetailInfo" />

    <TextView
        android:id="@+id/tvDetailInstructor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:text="Instructor: Nombre del Usuario"
        android:textColor="#3F51B5"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/glassCard"
        app:layout_constraintStart_toStartOf="@+id/glassCard"
        app:layout_constraintTop_toBottomOf="@+id/tvDetailDescription" />

    <Button
        android:id="@+id/btnRegresar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_rounded_button"
        android:text="Regresar"
        android:textAllCaps="false"
        android:textColor="#3F51B5"
        android:textSize="18sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>